1 ICON "icon.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 3,5,0,0
PRODUCTVERSION 3,5,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "FPS Boost"
      VALUE "FileDescription", "FPS Boost"
      VALUE "FileVersion", "3.5.0"
      VALUE "InternalName", "FPSBoost"
      VALUE "OriginalFilename", "FPSBoost.exe"
      VALUE "ProductName", "FPS Boost"
      VALUE "ProductVersion", "3.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
